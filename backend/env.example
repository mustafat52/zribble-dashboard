# Copy to .env and fill in values for local development.
# On Railway, DATABASE_URL and PORT are injected automatically — do not set them manually.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zribbleos"

# Generate with: openssl rand -hex 64
JWT_SECRET="replace-with-64-char-hex-secret"

FRONTEND_URL="http://localhost:3000"

NODE_ENV="development"
